{
  "name": "ai-kb-harness-template",
  "version": "0.8.0",
  "private": true,
  "description": "\u041f\u0435\u0440\u0435\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u0430\u044f \u0431\u0430\u0437\u0430 \u0437\u043d\u0430\u043d\u0438\u0439 \u0434\u043b\u044f \u043b\u044e\u0434\u0435\u0439 \u0438 AI-\u0430\u0433\u0435\u043d\u0442\u043e\u0432: \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438, \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u044b\u0435 \u0432\u044b\u0432\u043e\u0434\u044b, \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u043c\u044b\u0435 \u043d\u0430\u0432\u044b\u043a\u0438, \u0432\u0435\u0431-\u0432\u0438\u0442\u0440\u0438\u043d\u0430 \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0430.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "setup": "pnpm -C scripts/semantic install && pnpm -C scripts/skillopt install && pnpm -C tools/viewer install",
    "skill": "node scripts/skillopt/cli.mjs",
    "kb:index": "node scripts/semantic/index.mjs",
    "kb:search": "node scripts/semantic/search.mjs",
    "kb:think": "node scripts/semantic/think.mjs",
    "kb:doctor": "node scripts/kb-doctor.mjs",
    "kb:eval": "node scripts/semantic/eval.mjs",
    "kb:verify": "node scripts/semantic/verify.mjs",
    "kb:critic": "node scripts/kb-critic.mjs",
    "kb:dream": "node scripts/dream-cycle.mjs",
    "viewer:dev": "cd tools/viewer && pnpm dev",
    "viewer:build": "pnpm -C tools/viewer build",
    "kb:init": "node scripts/kb-init.mjs",
    "kb:update": "node scripts/kb-update.mjs",
    "kb:metrics": "node scripts/kb-metrics.mjs",
    "kb:digest": "node scripts/kb-digest.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/git-hooks/check.mjs",
    "harness:check": "node scripts/check-harness.mjs",
    "harness:setup": "node scripts/check-harness.mjs --setup",
    "kb:context": "node scripts/session-start-context.mjs",
    "kb:session": "node scripts/kb-session.mjs",
    "kb:spaces": "node scripts/check-spaces.mjs",
    "kb:portability": "node scripts/check-portability.mjs",
    "kb:readability": "node scripts/check-readability.mjs",
    "kb:release:baseline": "node scripts/template-release.mjs --write",
    "kb:release:check": "node scripts/template-release.mjs --check",
    "viewer:test": "pnpm -C tools/viewer test",
    "kb:profile": "node scripts/kb-profile.mjs",
    "kb:findings": "node scripts/kb-findings.mjs",
    "kb:research": "node scripts/kb-research.mjs",
    "kb:roster": "node scripts/kb-roster.mjs",
    "kb:approve": "node scripts/kb-approve.mjs",
    "kb:inbox": "node scripts/kb-inbox.mjs",
    "kb:invariants": "node scripts/check-invariants.mjs",
    "kb:document:build": "node scripts/build-document.mjs",
    "kb:documents": "node scripts/check-documents.mjs"
  }
}
